# Local production run. Copy to .env.local-prod (gitignored) and fill in.
# Same variables as .env.prod, but pointed at localhost -- no SOPS, no DNS.
# Keep values on their own line: docker compose does not reliably strip
# inline "# comments" from an --env-file.

# -- edge / TLS --
RF_DOMAIN=localhost
# Caddy issues its own cert (one browser warning); no Let's Encrypt.
RF_TLS=tls internal
# unused while RF_TLS is set, but the variable is still required
ACME_EMAIL=you@example.com
RF_ACME_CA=

# -- gateway image (built by the overlay, not pulled) --
RF_IMAGE_TAG=local

# -- required secrets --
# openssl rand -base64 48
RF_SESSION_SECRET=CHANGE_ME
RF_DATABASE_URL=postgres://postgres:devpassword@postgres:5432/ringfence
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=ringfence

# -- providers (optional locally) --
RF_ASR_PROVIDER=null
ASSEMBLYAI_API_KEY=
OLLAMA_API_KEY=

# -- behaviour --
# flip to false to exercise guardian webhooks
RF_DRY_RUN=true

# -- monitoring: any URL that accepts a POST (e.g. a https://webhook.site id) --
RF_ALERT_WEBHOOK_URL=https://webhook.site/00000000-0000-0000-0000-000000000000
# Grafana admin password (http://localhost:3000). Local view is anonymous
# Admin anyway; this is only for the actual admin login.
RF_GRAFANA_ADMIN_PASSWORD=admin

# -- optional: per-tenant guardian secret (config/tenants.yaml: acme) --
RF_GUARDIAN_SECRET_ACME=
