# Copy to .env.prod, fill in, then SOPS-encrypt it (see docs/DEPLOY.md).
# .env.prod itself is gitignored; only this example is committed.

# --- edge / TLS ------------------------------------------------------
RF_DOMAIN=ringfence.example.com
ACME_EMAIL=ops@example.com
# While DNS is still settling, point Caddy at the Let's Encrypt staging CA
# to avoid burning the strict prod rate limit. Unset for real certificates.
RF_ACME_CA=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

# --- gateway image -------------------------------------------------
# The CD pipeline pushes ghcr.io/achrefjr1997/ringfence-gateway:<git-sha>.
# Pin the exact tag you are running; bump it to deploy, restore it to roll back.
RF_IMAGE_TAG=latest

# --- required secrets --------------------------------------------
# 32+ random bytes, base64/hex. Rotating this invalidates every session,
# verification, reset and invite token at once (by design).
RF_SESSION_SECRET=
RF_DATABASE_URL=postgres://ringfence:CHANGE_ME@postgres:5432/ringfence
POSTGRES_PASSWORD=CHANGE_ME

# --- providers ---------------------------------------------------
RF_ASR_PROVIDER=null            # null | assemblyai
ASSEMBLYAI_API_KEY=
OLLAMA_API_KEY=

# --- behaviour --------------------------------------------------
RF_DRY_RUN=true                 # keep true until the action plane is signed off

# --- monitoring -----------------------------------------------
# Where Alertmanager POSTs firing/resolved alerts (a phone-push relay,
# Slack incoming webhook, PagerDuty Events v2, ...). Required by the
# alertmanager service. See docs/RUNBOOKS.md ("Alerts").
RF_ALERT_WEBHOOK_URL=https://hooks.example/ringfence-alerts
# Grafana admin password (internal only -- reach it over an SSH tunnel).
RF_GRAFANA_ADMIN_PASSWORD=

# --- per-tenant guardian webhook secrets --------------------
# One env var per tenant that has guardian_webhook_url in config/tenants.yaml;
# the var name is set by guardian_webhook_secret_env there.
RF_GUARDIAN_SECRET_ACME=

# --- P7 call-audio recording (OFF; needs a legal basis + DPA) ------
# See docs/LEGAL_AUDIO.md. A tenant also opts in via config/tenants.yaml.
RF_RETAIN_AUDIO=false
RF_AUDIO_RETENTION_DAYS=7
