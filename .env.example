ASSEMBLYAI_API_KEY=
RF_DRY_RUN=true
RF_POLICY_PACK=config/policy/default.yaml

# --- Telnyx ingress (apps/telnyx) -- see docs/DEMO_TELNYX.md ---------------
# Two different secrets. Mixing them up is the most likely setup mistake, so
# the loader refuses a value that looks like a provider credential.
#
# Portal -> Account Settings -> Public Key. Verifies webhooks Telnyx sends us.
RF_TELNYX_PUBLIC_KEY=
# A RingFence API key. Authenticates us to our own /ws/capture. NOT a Telnyx
# key -- a Telnyx API key (KEY0123...) pasted here is rejected at startup.
RF_TELNYX_GATEWAY_KEY=
# https://<tunnel-or-host> Telnyx can reach. No trailing slash.
RF_TELNYX_PUBLIC_URL=
# The protected person's phone, E.164. A +216 mobile is fine -- it only has
# to receive a call, which is why no Tunisian DID is needed for a demo.
RF_TELNYX_DIAL_TO=
# fr or en. Not ar_tn: AssemblyAI transcribes no Arabic, so Derja would run
# against NullASR and score on signalling only.
RF_TELNYX_LANGUAGE=fr
RF_TELNYX_TENANT=
RF_TELNYX_CONSENT_TOKEN=
RF_TELNYX_PORT=8101

# --- Twilio ingress (apps/twilio) -- same shape, unusable from Tunisia ------
# Kept because the code is provider-neutral and Twilio is the right answer
# elsewhere; Twilio sells no +216 and would not SMS a Tunisian number to
# verify the account at all.
RF_TWILIO_AUTH_TOKEN=
RF_TWILIO_GATEWAY_KEY=
RF_TWILIO_PUBLIC_URL=
RF_TWILIO_DIAL_TO=
RF_TWILIO_LANGUAGE=fr
RF_TWILIO_PORT=8100

# Where both ingresses send decoded audio.
RF_GATEWAY_WS=ws://localhost:8000/ws/capture
